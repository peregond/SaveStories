   "1",
   "-i",
   "/m/s.png",
   "-filter_complex",
   "[0:v]scale=1080:1920:force_original_aspect_ratio=increase:flags=lanczos,crop=1080:1920[basev];[basev]hue=h=3[adjustedv];[1:v]scale=1080:1920:force_original_aspect_ratio=decrease:flags=lanczos,pad=1080:1920:(ow-iw)/2:(oh-ih)/2,trim=duration=0.7,setpts=PTS-STARTPTS[introv];[adjustedv][introv]overlay=0:0:enable='between(t,0,0.7)'[introout];[3:v]scale=1080:1920:flags=lanczos[overlayv];[introout][overlayv]overlay=0:0:shortest=1[vout];[2:v]scale=1080:1920:force_original_aspect_ratio=increase:flags=lanczos,crop=1080:1920,format=rgba,colorchannelmixer=aa=0.3[vidoverlay];[vout][vidoverlay]overlay=0:0:shortest=1[voverlay];[voverlay]setpts=0.909091*PTS[vspeed];[vspeed]setsar=1[vfinal]",
   "-map",
   "[vfinal]",
   "-r",
   "30",
   "-map",
   "0:a?",
   "-shortest",
   "-af",
   "atempo=1.1000,loudnorm=I=-16:TP=-1.5:LRA=11,apad",
   "-map_metadata",
   "-1",
   "-threads",
   "2",
   "-c:v",
   "libx264",
   "-preset",
   "veryfast",
   "-crf",
   "25",
   "-pix_fmt",
   "yuv420p",
   "-movflags",
   "+faststart",
   "-maxrate",
   "2300k",
   "-bufsize",
   "4600k",
   "-c:a",
   "aac",
   "-b:a",
   "128k",
