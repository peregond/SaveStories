{
 "plain_story": {
  "job": {
   "input": {
    "filePath": "/in/src.mp4",
    "mediaKind": "video"
   },
   "output": {
    "container": "mp4",
    "videoCodec": "h264",
    "audioCodec": "aac"
   },
   "transforms": {
    "resize": {
     "width": 1080,
     "height": 1920,
     "fit": "cover",
     "backgroundStyle": "bars",
     "backgroundColor": "#111111"
    },
    "fps": 30,
    "bitrate": "2M",
    "audioNormalize": true,
    "stripMetadata": true,
    "hueShift": 0,
    "saturation": 1,
    "sharpness": 0
   }
  },
  "ffmpegArgs": [
   "-y",
   "-i",
   "/in/src.mp4",
   "-vf",
   "scale=1080:1920:force_original_aspect_ratio=increase:flags=lanczos,crop=1080:1920,setsar=1",
   "-map",
   "0:v:0",
   "-r",
   "30",
   "-map",
   "0:a?",
   "-shortest",
   "-af",
   "loudnorm=I=-16:TP=-1.5:LRA=11,apad",
   "-map_metadata",
   "-1",
   "-threads",
   "2",
   "-c:v",
   "libx264",
   "-preset",
   "veryfast",
   "-crf",
   "25",
   "-pix_fmt",
   "yuv420p",
   "-movflags",
   "+faststart",
   "-maxrate",
   "2300k",
   "-bufsize",
   "4600k",
   "-c:a",
   "aac",
   "-b:a",
   "128k",
   "/out/plain_story.mp4"
  ]
 },
