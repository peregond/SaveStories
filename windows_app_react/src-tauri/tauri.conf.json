{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaveMe",
  "mainBinaryName": "SaveMe-Windows",
  "version": "0.6.90",
  "identifier": "app.saveme.windows",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "SaveMe",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
